package blog

import (
	"fdt-templ/components"
	"fdt-templ/components/banner"
	"fdt-templ/components/layouts"
	"fdt-templ/components/common"
	blog_content "fdt-templ/internal/blog"
)

type BlogPostData struct {
	Post            *blog_content.Post
	BreadcrumbItems []components.BreadcrumbItem
	LayoutProps     layouts.BaseLayoutProps
}

templ Post(data BlogPostData) {
	@layouts.BaseLayout(data.LayoutProps) {
		@PostContent(data)
	}
}

templ PostContent(data BlogPostData) {
	<style>
		:global(.prose pre) {
			background: #0f172a;
			color: #e5e7eb;
			padding: 1rem;
			border-radius: 0.5rem;
			overflow-x: auto;
			font-size: 0.875rem;
			line-height: 1.6;
			border: 1px solid #1e293b;
		}
		:global(.prose code) {
			background: #e5e7eb;
			color: #0f172a;
			padding: 0.2rem 0.4rem;
			border-radius: 0.25rem;
			font-size: 0.875rem;
		}
		:global(.prose pre code) {
			background: transparent;
			padding: 0;
			color: inherit;
			border: none;
		}
		:global(.dark .prose pre) {
			background: #020617;
			border-color: #1e293b;
		}
		:global(.dark .prose code) {
			background: #1e293b;
			color: #e5e7eb;
		}
	</style>

	<div id="blog-post-container" style="margin-bottom: 2.5rem;">
		<div id="blog-post-ad-banner">
			@banner.AdsenseBanner(data.LayoutProps.Canonical)
		</div>

		<div id="blog-post-head-container">
			<div id="blog-post-breadcrumb-container" class="mb-10">
				@components.Breadcrumb(data.BreadcrumbItems)
			</div>
			<div id="blog-post-head-content">
				<h1 id="head-title" class="text-2xl font-medium mb-2 text-black dark:text-slate-300">
					{ data.Post.Title }
				</h1>
				if data.Post.Author != "" || data.Post.Date != "" {
					<p class="text-sm text-slate-500 dark:text-slate-400">
						if data.Post.Author != "" {
							By { data.Post.Author }
						}
						if data.Post.Author != "" && data.Post.Date != "" {
							{ " — " }
						}
						if data.Post.Date != "" {
							{ data.Post.Date }
						}
					</p>
				}
				if data.Post.Description != "" {
					<p class="text-muted-foreground mt-2">
						{ data.Post.Description }
					</p>
				}
			</div>
		</div>

		if data.Post.FeatureImage != "" {
			<div class="mt-6 w-full max-h-[28rem] overflow-hidden rounded-lg flex items-center justify-center">
				<img
					src={ data.Post.FeatureImage }
					alt={ data.Post.Title }
					class="block w-full h-auto max-h-[28rem] object-contain"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			</div>
		}

		<div class="mt-6">
			<div
				class="prose prose-slate dark:prose-invert max-w-none prose-headings:text-slate-900 dark:prose-headings:text-slate-100 prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline prose-code:text-blue-600 dark:prose-code:text-blue-400 prose-code:bg-slate-100 dark:prose-code:bg-slate-700 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-pre:bg-slate-100 dark:prose-pre:bg-slate-800 prose-pre:border prose-pre:border-slate-200 dark:prose-pre:border-slate-600 prose-blockquote:border-l-blue-500 prose-blockquote:bg-slate-100 dark:prose-blockquote:bg-slate-700 prose-blockquote:px-4 prose-blockquote:py-2 prose-blockquote:rounded prose-ul:space-y-1 prose-li:text-slate-700 dark:prose-li:text-slate-300 prose-img:rounded-lg"
			>
				@templ.Raw(data.Post.HTMLContent)
			</div>
		</div>

		<div class="mt-10 pt-6 mb-8 border-t border-slate-200 dark:border-slate-700">
			<div class="flex flex-wrap gap-4">
				@common.BackButton("/freedevtools/blog/", "Back to Blog")
			</div>
		</div>
	</div>
}
