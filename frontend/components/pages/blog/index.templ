package blog

import (
	"fmt"
	"fdt-templ/components"
	"fdt-templ/components/banner"
	"fdt-templ/components/layouts"
	"fdt-templ/components/common"
	blog_content "fdt-templ/internal/blog"
)

type BlogIndexData struct {
	Posts           []*blog_content.Post
	CurrentPage     int
	TotalPages      int
	TotalPosts      int
	BreadcrumbItems []components.BreadcrumbItem
	LayoutProps     layouts.BaseLayoutProps
}

templ Index(data BlogIndexData) {
	@layouts.BaseLayout(data.LayoutProps) {
		@IndexContent(data)
	}
}

templ IndexContent(data BlogIndexData) {
	<div class="mb-6 mt-0 md:mt-2">
		@banner.AdsenseBanner(data.LayoutProps.Canonical)
	</div>
	<div id="blog-index-container" style="margin-bottom: 2.5rem;">
		<div class="mb-6">
			@components.Breadcrumb(data.BreadcrumbItems)
			<h1 class="text-3xl font-bold mb-4 mt-4 text-black dark:text-slate-300">
				Blogs
			</h1>
			<p class="text-slate-600 dark:text-slate-400 mb-4">
				{ data.LayoutProps.Description }
			</p>
		</div>

		<div id="blog-pagination-info-content" class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4 mb-6 mt-8">
			<div class="text-sm text-slate-600 dark:text-slate-400 text-center">
				Showing { fmt.Sprintf("%d", len(data.Posts)) } of { fmt.Sprintf("%d", data.TotalPosts) } posts (Page { fmt.Sprintf("%d", data.CurrentPage) } of { fmt.Sprintf("%d", data.TotalPages) })
			</div>
		</div>

		<div id="blog-posts-grid" class="mt-10 mb-6">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				for _, post := range data.Posts {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/freedevtools/blog/%s/", post.Slug)) }
						class="group block"
					>
						if post.FeatureImage != "" {
							<div class="w-full h-48 overflow-hidden rounded-lg mb-4 bg-slate-100 dark:bg-slate-800">
								<img
									src={ post.FeatureImage }
									alt={ post.Title }
									class="block w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-in-out"
									loading="lazy"
								/>
							</div>
						}
						<h2 class="text-xl font-bold text-black dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
							{ post.Title }
						</h2>
						if post.Description != "" {
							<p class="text-sm text-slate-600 dark:text-slate-400 mt-2 line-clamp-2">
								{ post.Description }
							</p>
						}
						if post.Author != "" || post.Date != "" {
							<div class="text-sm text-slate-500 dark:text-slate-400 mt-3">
								if post.Author != "" {
									By { post.Author }
								}
								if post.Author != "" && post.Date != "" {
									{ " — " }
								}
								if post.Date != "" {
									{ post.Date }
								}
							</div>
						}
					</a>
				}
			</div>
		</div>

		@components.Pagination(components.NewPaginationData(data.CurrentPage, data.TotalPages, "/freedevtools/blog/", false))

		<div class="mt-10 pt-6 mb-8 border-t border-slate-200 dark:border-slate-700">
			@common.BackButton("/freedevtools/", "Back to Free DevTools")
		</div>
		@common.PaginationScript()
	</div>
}
