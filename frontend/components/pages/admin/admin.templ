package admin

import (
	"fdt-templ/components/layouts"
	"fdt-templ/internal/db/bookmarks"
	"fmt"
	"strings"
)

templ AdminPage(users []bookmarks.IPMDashboardUser) {
	@layouts.BaseLayout(layouts.BaseLayoutProps{
		Title:       "Admin Dashboard | Free DevTools Platform",
		Description: "Admin utilities and dashboard for Free DevTools.",
		Canonical:   "https://hexmos.com/freedevtools/admin/",
		ShowHeader:  true,
	}) {
		<style>
			.admin-tab { border-bottom: 2px solid transparent; color: rgb(100 116 139); }
			.admin-tab:hover { color: rgb(30 41 59); border-bottom-color: rgb(203 213 225); }
			.admin-tab[aria-selected="true"] { color: rgb(37 99 235); border-bottom-color: rgb(37 99 235); }
			.admin-tab.is-danger[aria-selected="true"] { color: rgb(220 38 38); border-bottom-color: rgb(220 38 38); }
			.dark .admin-tab { color: rgb(148 163 184); }
			.dark .admin-tab:hover { color: rgb(226 232 240); border-bottom-color: rgb(71 85 105); }
			.dark .admin-tab[aria-selected="true"] { color: rgb(96 165 250); border-bottom-color: rgb(96 165 250); }
			.dark .admin-tab.is-danger[aria-selected="true"] { color: rgb(248 113 113); border-bottom-color: rgb(248 113 113); }
		</style>
		<div class="not-prose max-w-5xl mx-auto px-4 py-8">
			<div class="mb-6">
				<h1 class="m-0 text-2xl font-bold text-slate-900 dark:text-slate-100">Admin Dashboard</h1>
				<p class="mt-1 mb-0 text-sm text-slate-600 dark:text-slate-400">Manage Installerpedia content and metrics dashboard access.</p>
			</div>

			<div class="bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 shadow-sm">
				<!-- Tabs -->
				<div class="px-4 sm:px-6 border-b border-slate-200 dark:border-slate-700">
					<div role="tablist" aria-label="Installerpedia admin sections" class="flex gap-6 -mb-px overflow-x-auto">
						<button type="button" role="tab" id="tab-access" aria-controls="panel-access" aria-selected="true" tabindex="0" data-tab="access" class="admin-tab whitespace-nowrap py-3 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-t">
							Dashboard Access
							<span class="ml-1.5 inline-flex items-center justify-center min-w-[1.25rem] px-1.5 py-0.5 text-xs rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300">{ fmt.Sprint(len(users)) }</span>
						</button>
						<button type="button" role="tab" id="tab-remove" aria-controls="panel-remove" aria-selected="false" tabindex="-1" data-tab="remove" class="admin-tab is-danger whitespace-nowrap py-3 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded-t">
							Remove Page
						</button>
					</div>
				</div>

				<!-- Panel: Dashboard Access -->
				<div role="tabpanel" id="panel-access" aria-labelledby="tab-access" class="p-4 sm:p-6">
					<h2 class="m-0 text-lg font-semibold text-slate-900 dark:text-slate-100">IPM Dashboard Access</h2>
					<p class="mt-1 mb-5 text-sm text-slate-600 dark:text-slate-400">Give a user access to specific IPM metrics dashboards by email and repository slugs.</p>

					<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-start">
						<div>
							<label for="ipm-user-email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">User email</label>
							<input type="email" id="ipm-user-email" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-slate-800 dark:border-slate-600 dark:text-white dark:placeholder-slate-500" placeholder="name@example.com"/>
						</div>
						<div>
							<label for="ipm-slugs" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Slugs (comma-separated)</label>
							<textarea id="ipm-slugs" rows="3" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-slate-800 dark:border-slate-600 dark:text-white dark:placeholder-slate-500" placeholder="tool/hexmostech-git-lrc/"></textarea>
							<p class="mt-1 mb-0 text-xs text-slate-500 dark:text-slate-400">Example: tool/hexmostech-git-lrc/</p>
						</div>
					</div>
					<div class="mt-4 flex flex-wrap items-center gap-3">
						<button id="ipm-add-btn" type="button" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-5 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 dark:focus:ring-offset-slate-900">Grant Access</button>
						<div id="ipm-status" class="text-sm hidden"></div>
					</div>

					<div class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-700">
						<h3 class="m-0 mb-3 text-base font-semibold text-slate-900 dark:text-slate-100">Existing users</h3>
						if len(users) > 0 {
							<div class="overflow-x-auto rounded-md border border-slate-200 dark:border-slate-700">
								<table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
									<thead class="bg-slate-50 dark:bg-slate-800">
										<tr>
											<th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">User</th>
											<th scope="col" class="px-4 py-2.5 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Accessible slugs</th>
											<th scope="col" class="px-4 py-2.5 text-right text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Actions</th>
										</tr>
									</thead>
									<tbody class="bg-white dark:bg-slate-900 divide-y divide-slate-200 dark:divide-slate-700">
										for _, usr := range users {
											<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
												<td class="px-4 py-3 align-top">
													<div class="text-sm font-medium text-slate-900 dark:text-white">
														if usr.Email != "" {
															{ usr.Email }
														} else {
															<span class="text-slate-400 italic">Unknown email</span>
														}
													</div>
													<div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400 font-mono break-all">{ usr.UID }</div>
												</td>
												<td class="px-4 py-3 align-top">
													<div class="flex flex-wrap gap-1.5">
														if len(usr.Slugs) > 0 {
															for _, slug := range usr.Slugs {
																<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300 border border-blue-200 dark:border-blue-800">{ slug }</span>
															}
														} else {
															<span class="text-xs text-slate-500 italic">No slugs assigned</span>
														}
													</div>
												</td>
												<td class="px-4 py-3 align-top whitespace-nowrap text-right text-sm font-medium">
													<button type="button" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 select-user-btn" data-email={ usr.Email } data-slugs={ strings.Join(usr.Slugs, ", ") }>Edit access</button>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						} else {
							<div class="bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400 p-4 rounded-md border border-amber-200 dark:border-amber-900/50 text-sm">
								No user access mappings found. Grant access to a user to see them here.
							</div>
						}
					</div>
				</div>

				<!-- Panel: Remove Page -->
				<div role="tabpanel" id="panel-remove" aria-labelledby="tab-remove" class="hidden p-4 sm:p-6">
					<h2 class="m-0 text-lg font-semibold text-slate-900 dark:text-slate-100">Remove an Installerpedia page</h2>
					<p class="mt-1 mb-5 text-sm text-slate-600 dark:text-slate-400">Removes a repository page from the site. This takes effect immediately.</p>

					<label for="ipm-delete-repo" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Repository</label>
					<div class="flex flex-col sm:flex-row gap-3">
						<input type="text" id="ipm-delete-repo" autocomplete="off" spellcheck="false" class="flex-1 min-w-0 px-3 py-2 text-sm border border-slate-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 dark:bg-slate-800 dark:border-slate-600 dark:text-white dark:placeholder-slate-500" placeholder="owner/repo, e.g. hexmostech/git-lrc"/>
						<button id="ipm-delete-btn" type="button" class="inline-flex items-center justify-center bg-red-600 hover:bg-red-700 disabled:opacity-60 disabled:cursor-not-allowed text-white text-sm font-medium py-2 px-5 rounded-md transition-colors focus:outline-none focus:ring-2 focus:ring-red-400 focus:ring-offset-2 dark:focus:ring-offset-slate-900">Remove Page</button>
					</div>
					<div id="ipm-delete-status" role="status" class="hidden mt-4 text-sm rounded-md border px-3 py-2"></div>

					<div class="mt-6 rounded-md border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 p-4">
						<h3 class="m-0 mb-2 text-sm font-semibold text-slate-800 dark:text-slate-200">What happens</h3>
						<ul class="m-0 pl-5 text-sm text-slate-600 dark:text-slate-400 list-disc space-y-1">
							<li>The page is hidden and redirects to its category.</li>
							<li>Its search entry and pre-rendered static file are deleted.</li>
							<li>The daily indexer can never recreate it.</li>
							<li>The sitemap and category listing update on the next regeneration. Purge the CDN cache for the page URL as well.</li>
						</ul>
					</div>
				</div>
			</div>
		</div>

		<script>
			(function () {
				// ---- Tabs ----
				const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
				function activate(name, focus) {
					tabs.forEach(function (t) {
						const on = t.dataset.tab === name;
						t.setAttribute('aria-selected', on ? 'true' : 'false');
						t.tabIndex = on ? 0 : -1;
						document.getElementById('panel-' + t.dataset.tab).classList.toggle('hidden', !on);
						if (on && focus) t.focus();
					});
					try { history.replaceState(null, '', '#' + name); } catch (e) {}
				}
				tabs.forEach(function (t, i) {
					t.addEventListener('click', function () { activate(t.dataset.tab, false); });
					t.addEventListener('keydown', function (e) {
						if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
							e.preventDefault();
							const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
							activate(next.dataset.tab, true);
						}
					});
				});
				const initial = (location.hash || '').replace('#', '');
				if (tabs.some(function (t) { return t.dataset.tab === initial; })) activate(initial, false);

				const basePath = window.location.pathname.split('/admin')[0] || '';

				// ---- Dashboard access ----
				document.querySelectorAll('.select-user-btn').forEach(function (btn) {
					btn.addEventListener('click', function (e) {
						const emailInput = document.getElementById('ipm-user-email');
						const slugsInput = document.getElementById('ipm-slugs');
						const existingSlugs = e.target.getAttribute('data-slugs');
						emailInput.value = e.target.getAttribute('data-email');
						// Put existing slugs in the box so the admin can extend the list
						slugsInput.value = existingSlugs ? (existingSlugs + ', ') : '';
						slugsInput.focus();
						emailInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
					});
				});

				document.getElementById('ipm-add-btn').addEventListener('click', async function () {
					const email = document.getElementById('ipm-user-email').value.trim();
					const slugsStr = document.getElementById('ipm-slugs').value.trim();
					const statusEl = document.getElementById('ipm-status');
					const setStatus = function (msg, cls) {
						statusEl.textContent = msg;
						statusEl.className = 'text-sm ' + cls;
					};

					if (!email || !slugsStr) {
						setStatus('Email and slugs are required.', 'text-red-600 dark:text-red-400');
						return;
					}
					// Clean, split, and deduplicate slugs
					const slugs = Array.from(new Set(slugsStr.split(',').map(function (s) { return s.trim(); }).filter(Boolean)));

					setStatus('Granting access...', 'text-blue-600 dark:text-blue-400');
					try {
						const resp = await fetch(basePath + '/api/admin/ipm/add-user', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ email: email, slugs: slugs })
						});
						if (resp.ok) {
							setStatus('Access granted for ' + slugs.length + ' slug(s). Refreshing...', 'text-emerald-600 dark:text-emerald-400');
							setTimeout(function () { window.location.reload(); }, 1000);
						} else {
							const errorText = await resp.text().catch(function () { return ''; });
							setStatus('Failed to grant access. ' + (errorText.length < 50 ? errorText : 'Please check your inputs or try again later.'), 'text-red-600 dark:text-red-400');
						}
					} catch (e) {
						setStatus('A network error occurred: ' + e.message, 'text-red-600 dark:text-red-400');
					}
				});

				// ---- Remove page ----
				const input = document.getElementById('ipm-delete-repo');
				const delBtn = document.getElementById('ipm-delete-btn');
				const delStatus = document.getElementById('ipm-delete-status');
				const tones = {
					info: 'text-blue-800 bg-blue-50 border-blue-200 dark:text-blue-200 dark:bg-blue-900/30 dark:border-blue-800',
					ok: 'text-emerald-800 bg-emerald-50 border-emerald-200 dark:text-emerald-200 dark:bg-emerald-900/30 dark:border-emerald-800',
					warn: 'text-amber-800 bg-amber-50 border-amber-200 dark:text-amber-200 dark:bg-amber-900/30 dark:border-amber-800',
					err: 'text-red-800 bg-red-50 border-red-200 dark:text-red-200 dark:bg-red-900/30 dark:border-red-800'
				};
				function showDelete(msg, tone) {
					delStatus.textContent = msg;
					delStatus.className = 'mt-4 text-sm rounded-md border px-3 py-2 ' + tones[tone];
				}
				async function removePage() {
					const repo = input.value.trim();
					if (!repo) { showDelete('Enter a repository as owner/name.', 'err'); input.focus(); return; }
					if (!confirm('Permanently remove "' + repo + '" from Installerpedia and search? It will not be regenerated.')) return;
					delBtn.disabled = true;
					showDelete('Removing...', 'info');
					try {
						const resp = await fetch(basePath + '/api/admin/ipm/delete-repo', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ repo: repo })
						});
						if (resp.ok) {
							const data = await resp.json();
							if (data.meili_removed) {
								showDelete('Removed ' + data.repo + '. Search entry removed' + (data.static_removed ? ' and static page deleted.' : '.'), 'ok');
							} else {
								showDelete('Removed ' + data.repo + ', but the search index removal failed. Check the server logs.', 'warn');
							}
							input.value = '';
						} else {
							const text = (await resp.text().catch(function () { return ''; })).trim();
							showDelete('Failed (' + resp.status + '): ' + (text || 'unknown error'), 'err');
						}
					} catch (e) {
						showDelete('Network error: ' + e.message, 'err');
					} finally {
						delBtn.disabled = false;
					}
				}
				delBtn.addEventListener('click', removePage);
				input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); removePage(); } });
			})();
		</script>
	}
}
